# Mẫu biến môi trường cho backend. Chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env.

# Nguồn dữ liệu: espn (mặc định) hoặc demo (dữ liệu mẫu, không gọi mạng).
DATA_PROVIDER=espn

# Nơi ghi dữ liệu tự sinh. Để trống thì dùng backend/data.
# Trên máy chủ thuê phải trỏ vào ổ đĩa gắn thêm, nếu không mất sạch mỗi
# lần triển khai lại.
DATA_DIR=

# Hộp thư nhận góp ý của người dùng. Dùng mật khẩu ứng dụng của Gmail,
# KHÔNG phải mật khẩu đăng nhập.
FEEDBACK_SMTP_HOST=smtp.gmail.com
FEEDBACK_SMTP_PORT=587
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_TO=
